# ==============================================
# Keystone - Environment Variables
# ==============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ==============================================
# REQUIRED - Application will not start without these
# ==============================================

# PostgreSQL connection string
# Local Docker: postgresql://postgres:password@localhost:5432/keystone
# Neon:         postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/keystone

# OpenRouter API key - every text-model call (chat agent, graders, research swarm)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pangram API key (AI Writing Signal feature). Server exits at boot if missing.
PANGRAM_API_KEY=your_pangram_api_key_here

# Brand selector (server + client must match). Valid values: keystone | brainlift
BRAND=keystone
VITE_BRAND=keystone
# Page <title> injected into client/index.html at build time
VITE_BRAND_NAME=Keystone

# ==============================================
# REQUIRED IN PRODUCTION - Auth
# ==============================================

# Session signing secret: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public base URL of this deployment, e.g. https://keystone.example.com
BETTER_AUTH_URL=http://localhost:5000
# Comma-separated extra origins allowed to call the auth API (optional)
# TRUSTED_ORIGINS=

# Google sign-in (the only self-service login in production).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production sign-up allowlist: only these emails may create an account.
# Unset in production = sign-up closed. Ignored outside production.
# AUTH_SIGNUP_ALLOWLIST=you@example.com,teammate@example.com

# ==============================================
# STRONGLY RECOMMENDED - Research
# ==============================================

# Exa API key (research swarm, chat web search, article extraction)
# Get your key at: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

# Research swarm runs allowed per user per day (cost control)
DAILY_SWARM_LIMIT=3

# ==============================================
# OPTIONAL - Server
# ==============================================

PORT=5000
NODE_ENV=development
# WORKER_CONCURRENCY=3
# Public URL used in share links when it differs from BETTER_AUTH_URL
# CLIENT_URL=

# ==============================================
# OPTIONAL - Additional AI providers (feature-gated)
# ==============================================

# Fireworks: failover text provider + image-generation fallback
# FIREWORKS_API_KEY=
# OpenAI: primary image generation (cover images)
# OPENAI_API_KEY=

# ==============================================
# OPTIONAL - LLM tracing (Langfuse via OpenTelemetry)
# ==============================================
# Set both keys to export per-step traces of chat turns and research-swarm
# agents (prompts, tool calls, token usage, cache hits). Leave unset to keep
# console logging only. Free tier at cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# EU cloud is the default; US cloud is https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=
# Label traces by deploy (defaults to NODE_ENV)
# LANGFUSE_TRACING_ENVIRONMENT=

# ==============================================
# OPTIONAL - Storage & integrations
# ==============================================

# S3-compatible storage for generated cover images
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# Google Drive service account for sprint deliverables (Google Docs)
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_DRIVE_SHARED_DRIVE_ID=
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=

# ==============================================
# OPTIONAL - Client build flags
# ==============================================

# Keep the "Dev quick login" panel visible on production builds (default off)
# VITE_ENABLE_DEV_LOGIN=false
# Comma-separated emails that see the "Providers" nav link (admins always do).
# Note: this is compiled into the public JS bundle; leave unset unless needed.
# VITE_PROVIDERS_ADMIN_ALLOWLIST=
